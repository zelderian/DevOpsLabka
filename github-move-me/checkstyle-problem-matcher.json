{
  "problemMatcher": [
    {
      "owner": "checkstyle",
      "pattern": [
        {
          "regexp": "^\\[(ERROR|WARN(?:ING)?)\\]\\s+(.+\\.java):\\[(\\d+)(?:,(\\d+))?\\]\\s+\\(\\w+\\)\\s+(\\w+):\\s+(.+)$",
          "severity": 1,
          "file": 2,
          "line": 3,
          "column": 4,
          "code": 5,
          "message": 6
        }
      ]
    }
  ]
}
