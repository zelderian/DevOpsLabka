{
  "info": {
    "name": "web-security26 JWT (Lab 8-9)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login ADMIN",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:8080/api/v1/auth/authenticate",
        "body": {
          "mode": "raw",
          "raw": "{\n \"email\": \"admin@mail.com\",\n \"password\": \"admin\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.collectionVariables.set(\"adminToken\", pm.response.json().token);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Login MANAGER",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:8080/api/v1/auth/authenticate",
        "body": {
          "mode": "raw",
          "raw": "{\n \"email\": \"manager@mail.com\",\n \"password\": \"manager\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.collectionVariables.set(\"managerToken\", pm.response.json().token);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Login USER",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:8080/api/v1/auth/authenticate",
        "body": {
          "mode": "raw",
          "raw": "{\n \"email\": \"user@mail.com\",\n \"password\": \"user\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.collectionVariables.set(\"userToken\", pm.response.json().token);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "1. USER: GET all items -> 200",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}"
          }
        ],
        "url": "http://localhost:8080/api/v1/items"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"200\", () => pm.response.to.have.status(200));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. USER: POST item -> 403",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}"
          }
        ],
        "url": "http://localhost:8080/api/v1/items",
        "body": {
          "mode": "raw",
          "raw": "{ \"name\": \"JWT user item\", \"description\": \"must be denied\" }"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"403\", () => pm.response.to.have.status(403));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3. MANAGER: POST item -> 201",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{managerToken}}"
          }
        ],
        "url": "http://localhost:8080/api/v1/items",
        "body": {
          "mode": "raw",
          "raw": "{ \"name\": \"JWT item\", \"description\": \"created with JWT\" }"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"id\", pm.response.json().id);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4. MANAGER: PUT item -> 200",
      "request": {
        "method": "PUT",
        "header": [
          {
